+
+@contextmanager
+def checkpoint_write_lock():
+    lock_path = os.environ.get("REBEL_CHECKPOINT_LOCK")
+    if not lock_path:
+        yield
+        return
+
+    import fcntl
+
+    with Path(lock_path).expanduser().open("a+b") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX)
+        yield
+
+
+def save_checkpoint(path, signature, next_step, weights, opt_state, key, peak_reward, collapse_steps):
+    """Commit a completed outer step as one replaceable archive."""
+    arrays = jax.tree.leaves((weights, opt_state))
+    metadata = json.dumps({"version": 1, "signature": signature, "next_step": next_step,
+                           "peak_reward": float(peak_reward), "collapse_steps": collapse_steps})
+    temporary = path.with_suffix(".tmp")
+    save_archive = np.savez_compressed if os.environ.get("REBEL_COMPRESS_CHECKPOINT") == "1" else np.savez
+    with checkpoint_write_lock():
+        with temporary.open("wb") as output:
+            save_archive(output, metadata=metadata, key=np.asarray(jax.random.key_data(key)),
+                         **{f"array_{i}": np.asarray(array) for i, array in enumerate(arrays)})
+            output.flush()
+            os.fsync(output.fileno())
+        temporary.replace(path)
+    print(f"REBEL_CHECKPOINT_SAVED step={next_step}", flush=True)
+
+
+def load_checkpoint(path, signature, stop_step, weights, opt_state, key):
+    templates, structure = jax.tree.flatten((weights, opt_state))
+    with np.load(path, allow_pickle=False) as archive:
+        metadata = json.loads(archive["metadata"].item())
+        if metadata["version"] != 1 or metadata["signature"] != signature:
+            raise ValueError(f"Checkpoint {path} does not match the requested run")
+        next_step = metadata["next_step"]
+        peak_reward = metadata["peak_reward"]
+        collapse_steps = metadata["collapse_steps"]
+        if (type(next_step) is not int or not 0 <= next_step <= stop_step
+                or not np.isfinite(peak_reward)
+                or type(collapse_steps) is not int or not 0 <= collapse_steps <= min(next_step, 10)):
+            raise ValueError(f"Invalid progress metadata in checkpoint {path}")
+        if set(archive.files) != {"metadata", "key"} | {f"array_{i}" for i in range(len(templates))}:
+            raise ValueError(f"Unexpected arrays in checkpoint {path}")
+        arrays = []
+        for i, template in enumerate(templates):
+            array = archive[f"array_{i}"]
+            if array.shape != template.shape or array.dtype != template.dtype:
+                raise ValueError(f"Unexpected shape or dtype for array {i} in checkpoint {path}")
+            arrays.append(jax.device_put(array, template.sharding))
+        key_data = archive["key"]
+        if key_data.shape != jax.random.key_data(key).shape or key_data.dtype != np.uint32:
+            raise ValueError(f"Invalid rollout RNG in checkpoint {path}")
+        key = jax.random.wrap_key_data(jnp.asarray(key_data), impl=jax.random.key_impl(key))
+    weights, opt_state = jax.tree.unflatten(structure, arrays)
+    return weights, opt_state, key, next_step, peak_reward, collapse_steps
+
+
+def restore_metric_log(path, next_step, resumed):
+    """Retain committed records and discard any steps ahead of the checkpoint."""
+    if not path.exists():
+        if next_step:
+            raise ValueError(f"Missing metrics for checkpoint at step {next_step}: {path}")
+        return
+    with path.open("r+b") as log:
+        if not resumed and log.read(1):
+            raise ValueError(f"Metrics already exist but the checkpoint is missing: {path}")
+        for expected in range(next_step):
+            line = log.readline()
+            if not line.endswith(b"\n") or json.loads(line)["step"] != expected:
+                raise ValueError(f"Missing or unordered metrics at step {expected}: {path}")
+        log.truncate()
+
